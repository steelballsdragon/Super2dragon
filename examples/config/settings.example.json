{
  "providers": [
    {
      "id": "ollama",
      "kind": "ollama",
      "label": "Ollama",
      "baseUrl": "http://127.0.0.1:11434",
      "enabled": true
    },
    {
      "id": "llamacpp",
      "kind": "openai",
      "label": "llama.cpp server",
      "baseUrl": "http://127.0.0.1:8080/v1",
      "enabled": true
    },
    {
      "id": "lmstudio",
      "kind": "openai",
      "label": "LM Studio",
      "baseUrl": "http://127.0.0.1:1234/v1",
      "enabled": false
    }
  ],
  "models": {
    "coding": {
      "providerId": "ollama",
      "model": "qwen2.5-coder:7b"
    },
    "light": {
      "providerId": "ollama",
      "model": "qwen3.5:4b"
    },
    "embedding": {
      "providerId": "ollama",
      "model": "nomic-embed-text:latest"
    }
  },
  "toolModeOverrides": {
    "ollama/qwen2.5-coder:1.5b": "prompted"
  },
  "generation": {
    "temperature": 0.2,
    "numCtx": 16384,
    "maxTokens": 4096,
    "numGpu": null,
    "keepAlive": "30m",
    "thinking": false
  },
  "agent": {
    "maxSteps": 60,
    "maxTaskMinutes": 90,
    "commandTimeoutSec": 300,
    "toolOutputMaxChars": 12000,
    "modelIdleTimeoutSec": 600,
    "nudgeOnIncompletePlan": true
  },
  "permissions": {
    "mode": "standard",
    "envPassthrough": []
  },
  "context": {
    "summarizeAtRatio": 0.75,
    "keepRecentMessages": 10,
    "includeRepoOverview": true,
    "includeRecentTasks": true
  },
  "index": {
    "exclude": [
      "*.min.js",
      "fixtures/large/"
    ],
    "maxFileSizeKB": 1024,
    "maxFiles": 50000,
    "watch": true
  },
  "storage": {
    "checkpoints": true
  },
  "firstRunComplete": true
}
