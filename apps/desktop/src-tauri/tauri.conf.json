{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LocalCode AI",
  "version": "0.1.0",
  "identifier": "ai.localcode.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build && node ../../scripts/prepare-sidecar.mjs",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LocalCode AI",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:*; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Local AI coding agent",
    "longDescription": "LocalCode AI is a fully local coding agent that uses open-weight models through Ollama or llama.cpp to read, edit and test code in your projects.",
    "resources": ["resources/engine/**/*"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "linux": {
      "deb": { "depends": [] }
    }
  }
}
